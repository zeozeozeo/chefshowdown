{
  "name": "chef-showdown-private-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, self-hosted server and preservation build for Mojiworks' Chef Showdown",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "download": "node scripts/download-game.mjs",
    "patch": "node scripts/patch-game.mjs",
    "bootstrap": "npm run download && npm run patch && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "web": "node server/web/index.mjs",
    "dev": "npm run build:server && node server/web/index.mjs",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "test:multiplayer": "node tests/multiplayer.e2e.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "@heroiclabs/nakama-js": "^2.8.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.52.0"
  }
}
